---
// M1 placeholder home page: exercises layout, tokens, fonts and images.
// Full home page is built in M2 (PLAN.md §11).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/photos/gallery-14.jpg';
import { site, formattedAddress } from '../data/site';
---

<BaseLayout>
  <section class="container-page grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-24">
    <div>
      <p class="eyebrow">Lee's Summit, MO</p>
      <h1 class="mt-4 text-5xl sm:text-6xl lg:text-7xl">
        Square One <span class="text-primary-bright">Jiu Jitsu</span> Academy
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted-foreground">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/free-trial" class="btn-primary">Your first class is free</a>
        <a href="/schedule" class="btn-outline">View class schedule</a>
      </div>
      <p class="mt-6 text-sm text-muted-foreground">{formattedAddress}</p>
    </div>
    <Image
      src={hero}
      alt="The Square One Jiu Jitsu team on the mats in Lee's Summit"
      widths={[480, 800, 1200, 1616]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="w-full rounded-(--radius) object-cover"
    />
  </section>
</BaseLayout>
