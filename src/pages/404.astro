---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="container-page py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-5xl sm:text-6xl">Back to square one</h1>
    <p class="mx-auto mt-6 max-w-md text-muted-foreground">We couldn't find that page. Try one of these instead.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-outline">Home</a>
      <a href="/schedule" class="btn-outline">Schedule</a>
      <a href="/free-trial" class="btn-primary">Free class</a>
    </div>
  </section>
</BaseLayout>
