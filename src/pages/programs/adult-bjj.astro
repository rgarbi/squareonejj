---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import WeeklySchedule from '../../components/WeeklySchedule.astro';
import FaqList from '../../components/FaqList.astro';
import PricingTable from '../../components/PricingTable.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import rollingPhoto from '../../assets/photos/gallery-25.jpeg';
import nogiPhoto from '../../assets/photos/gallery-17.jpg';
import { faqsFor } from '../../data/faq';
import { faqSchema, courseSchema } from '../../lib/schema';

const faqs = faqsFor('adult');

const styles = [
  {
    title: 'Adult Gi',
    body: 'Jiu-jitsu in the traditional uniform (kimono), where grips on the collar and sleeves shape the game. Gi training rewards patience, precision and technical detail.',
    when: 'Mon & Wed 6:00 AM · Tue & Thu 7:00 PM',
    image: rollingPhoto,
    alt: 'Square One adult gi class team photo on the mats',
  },
  {
    title: 'Adult No-Gi',
    body: 'Grappling in athletic clothing — rash guard and shorts — with a faster, grip-light style. Great for fitness, submission grappling and wrestling-style scrambles.',
    when: 'Mon & Wed 7:00 PM · Fri 6:00 AM',
    image: nogiPhoto,
    alt: 'Square One No-Gi students in rash guards',
  },
];

const expect = [
  ['Technique', 'We warm up by reviewing a base technique, then build on it step by step. You drill each piece with a partner at your own pace.'],
  ['Live training', 'Five 6-minute rounds of controlled sparring ("rolling") to put it into practice. Beginners ease in — you choose your intensity.'],
];
---

<BaseLayout
  title="Adult Jiu Jitsu Classes in Lee's Summit, MO"
  description="Adult Brazilian Jiu-Jitsu in Lee's Summit, MO. Gi and No-Gi classes for ages 13+, mornings and evenings, beginners welcome. Your first class is free."
  breadcrumb="Adult Jiu Jitsu"
  schema={[
    faqSchema(faqs),
    courseSchema({
      name: "Adult Brazilian Jiu-Jitsu (Gi & No-Gi)",
      description: 'Adult Brazilian Jiu-Jitsu classes in the Gi and No-Gi for ages 13 and up, beginners welcome.',
      path: '/programs/adult-bjj',
      programs: ['adult-gi', 'adult-nogi'],
      ages: '13-',
    }),
  ]}
>
  <PageHero
    eyebrow="Ages 13+ · Gi & No-Gi"
    title="Adult Jiu Jitsu in Lee's Summit"
    lead="Learn real grappling in a welcoming room where training partners look out for each other. Ten classes a week across early mornings and evenings — no experience or fitness level required."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/free-trial" class="btn-primary">Your first class is free</a>
      <a href="/schedule" class="btn-outline">See the schedule</a>
    </div>
  </PageHero>

  <section class="container-page mt-20 grid gap-8 md:grid-cols-2">
    {
      styles.map((s) => (
        <article class="overflow-hidden rounded-(--radius) border border-border bg-surface">
          <Image src={s.image} alt={s.alt} widths={[480, 800]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[16/9] w-full object-cover" />
          <div class="p-6">
            <h2 class="text-3xl">{s.title}</h2>
            <p class="mt-3 text-muted-foreground">{s.body}</p>
            <p class="mt-4 text-sm font-semibold">{s.when}</p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="Your first class" title="What a class looks like" />
    <ol class="mt-10 grid gap-6 md:grid-cols-2">
      {
        expect.map(([title, body], i) => (
          <li class="rounded-(--radius) border border-border bg-surface p-6">
            <p class="font-display text-5xl font-bold text-primary-bright">{i + 1}</p>
            <h3 class="mt-2 text-2xl">{title}</h3>
            <p class="mt-2 text-muted-foreground">{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="When" title="Adult class times" />
    <div class="mt-10"><WeeklySchedule audience="Adult" /></div>
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="Membership" title="Pricing" lead="Month-to-month. No contract, no enrollment fee." />
    <div class="mt-10"><PricingTable /></div>
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="Community" title="What students say" />
    <div class="mt-10"><Reviews /></div>
  </section>

  <section class="container-page mt-24 max-w-3xl">
    <SectionHeading eyebrow="FAQ" title="Adult program questions" />
    <div class="mt-8"><FaqList items={faqs} /></div>
  </section>

  <CtaBand />
</BaseLayout>
