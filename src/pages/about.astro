---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { coaches, values } from '../data/coaches';
import { site } from '../data/site';
import teamGi from '../assets/photos/gallery-2.jpg';
import lineagePhoto from '../assets/photos/gallery-24.jpeg';
import g4 from '../assets/photos/gallery-4.jpg';
import g13 from '../assets/photos/gallery-13.jpg';
import g14 from '../assets/photos/gallery-14.jpg';
import g15 from '../assets/photos/gallery-15.jpg';
import g16 from '../assets/photos/gallery-16.jpg';
import g17 from '../assets/photos/gallery-17.jpg';
import g18 from '../assets/photos/gallery-18.jpg';
import g21 from '../assets/photos/gallery-21.jpg';
import g23 from '../assets/photos/gallery-23.jpeg';
import g25 from '../assets/photos/gallery-25.jpeg';

// TODO: owners to confirm which photos were taken at Square One (PLAN.md §5.1).
// `wide` items span two columns: 11 photos fill a 4-column grid (and 2-column on mobile) exactly.
const gallery: { src: ImageMetadata; alt: string; wide?: boolean }[] = [
  { src: g25, alt: 'Square One adult gi class team photo on the mats', wide: true },
  { src: teamGi, alt: 'Square One team photo in gis' },
  { src: g14, alt: 'Square One nogi team photo' },
  { src: g23, alt: 'Square One kids class with their coaches' },
  { src: g18, alt: 'Students drilling gi jiu jitsu' },
  { src: g15, alt: 'Students and families celebrating together' },
  { src: g16, alt: 'Training partners working a position' },
  { src: g4, alt: 'A young student at a belt promotion' },
  { src: g13, alt: 'Square One teammates at a tournament' },
  { src: g17, alt: 'Students celebrating a belt promotion' },
  { src: g21, alt: 'A Square One competitor has his hand raised at a tournament' },
];

const personSchema = coaches.map((c) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: c.name,
  jobTitle: c.jobTitle,
  description: c.bio,
  worksFor: { '@id': `${site.url}/#business` },
}));
---

<BaseLayout
  breadcrumb="About"
  title="About Us — Coaches & Story"
  description="Square One Jiu Jitsu Academy was founded in 2023 by Josh Smith (black belt from Renato Tavares) and Heidi Smith in downtown Lee's Summit, MO. A Zenith BJJ affiliate under Robert Drysdale since 2026."
  schema={personSchema}
>
  <PageHero
    eyebrow="About"
    title="Starting from square one"
    lead="Founded in downtown Lee's Summit in 2023, Square One is built by its students, families and coaches — together, from square one."
  />

  <section class="container-page mt-20 grid items-center gap-10 lg:grid-cols-2">
    <div class="space-y-4 text-lg text-muted-foreground">
      <p>
        {site.name} provides dedicated jiu-jitsu instruction focused on grappling, with classes for adults and youth in the gi
        and in nogi.
      </p>
      <p>
        Square One is a place where adults and kids can learn jiu-jitsu through clear instruction,
        strong fundamentals and a welcoming team culture — for students who want to learn, stay active and keep growing on
        the mat, whether they plan to compete or not.
      </p>
    </div>
    <Image src={teamGi} alt="The Square One Jiu Jitsu team in gis" widths={[480, 800, 1080]} sizes="(min-width: 1024px) 50vw, 100vw" class="w-full rounded-(--radius) object-cover" />
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="The team" title="Coaches" />
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        coaches.map((c) => (
          <article class="rounded-(--radius) border border-border bg-surface p-6">
            <p class="eyebrow">{c.rank} · {c.role}</p>
            <h3 class="mt-2 text-3xl">{c.name}</h3>
            <p class="mt-3 text-muted-foreground">{c.bio}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page mt-24 grid items-center gap-10 lg:grid-cols-2">
    <div>
      <SectionHeading eyebrow="Lineage" title="Zenith BJJ under Robert Drysdale" />
      <div class="mt-6 space-y-4 text-muted-foreground">
        <p>
          Square One is a proud affiliate of <strong class="text-foreground">Zenith BJJ</strong>, led by Robert Drysdale —
          co-founder and head coach of Zenith Jiu-Jitsu, ADCC Absolute champion and IBJJF World champion. That lineage
          connects our Lee's Summit academy to one of jiu-jitsu's respected international teams.
        </p>
        <p>
          Head coach Josh Smith received his black belt from <strong class="text-foreground">Renato Tavares</strong> in 2023
          and joined <strong class="text-foreground">Robert Drysdale</strong> and Zenith BJJ in 2026.
        </p>
      </div>
    </div>
    <figure class="mx-auto w-full max-w-sm">
      <Image src={lineagePhoto} alt="Professor Josh Smith (right) with Robert Drysdale (left), both wearing black belts" widths={[400, 768]} sizes="(min-width: 1024px) 384px, 100vw" class="w-full rounded-(--radius) object-cover" />
      <figcaption class="mt-2 text-center text-sm text-muted-foreground">Robert Drysdale and Professor Josh Smith</figcaption>
    </figure>
  </section>

  <section class="container-page mt-24">
    <SectionHeading eyebrow="What we value" title="Our values" lead="What our team believes." />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        values.map((v) => (
          <article class="rounded-(--radius) border border-border bg-surface p-6">
            <h3 class="text-2xl">{v.title}</h3>
            <p class="mt-3 text-muted-foreground">{v.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="gallery" class="container-page mt-24 scroll-mt-20">
    <SectionHeading eyebrow="Gallery" title="On the mats" />
    <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
      {
        gallery.map((g) => (
          <li class:list={[g.wide && 'col-span-2']}>
            <Image
              src={g.src}
              alt={g.alt}
              widths={g.wide ? [700, 1024] : [400, 700]}
              sizes={g.wide ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
              class:list={['w-full rounded-(--radius) object-cover', g.wide ? 'aspect-[2/1] h-full md:aspect-auto' : 'aspect-square']}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand />
</BaseLayout>
