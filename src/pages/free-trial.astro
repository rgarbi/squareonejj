---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Gymdesk from '../components/Gymdesk.astro';
import Reviews from '../components/Reviews.astro';
import { gymdesk } from '../config/gymdesk';
import { site } from '../data/site';

const next = [
  ['Tell us who’s training', 'Adults, kids or both — and any experience. Takes about a minute.'],
  ['We reach out', 'We’ll contact you the way you prefer to answer questions and pick a class.'],
  ['Your first class is free', 'Wear athletic clothes, arrive 10 minutes early, and we’ll take care of the rest.'],
];
---

<BaseLayout
  breadcrumb="Free Trial"
  title="Free Jiu Jitsu Class"
  description="Schedule your free jiu-jitsu class at Square One in Lee's Summit, MO. Adults and kids, gi and nogi, no experience needed."
>
  <PageHero
    eyebrow="Free trial"
    title="Your first class is free"
    lead="Tell us a little about who's training and we'll reach out to set up your first class. No experience or fitness level required."
  />

  <section class="container-page mt-16 grid gap-10 lg:grid-cols-[3fr_2fr]">
    <div>
      <h2 class="sr-only">Free trial form</h2>
      <Gymdesk kind="form" formRef={gymdesk.forms.trial} title="Free trial class request form" minHeight={900}>
        <p class="text-neutral-800">
          Call <a href={`tel:${site.phone.e164}`} class="font-semibold underline">{site.phone.display}</a> or email
          <a href={`mailto:${site.email}`} class="font-semibold underline">{site.email}</a> to schedule your free class.
        </p>
      </Gymdesk>
    </div>

    <aside class="space-y-10">
      <div>
        <h2 class="text-3xl">What happens next</h2>
        <ol class="mt-6 space-y-5">
          {
            next.map(([title, body], i) => (
              <li class="flex gap-4">
                <span class="font-display text-4xl leading-none font-bold text-primary-bright">{i + 1}</span>
                <div>
                  <h3 class="font-sans text-base font-semibold normal-case tracking-normal">{title}</h3>
                  <p class="text-muted-foreground">{body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="rounded-(--radius) border border-border bg-surface p-6">
        <h2 class="text-2xl">Rather talk?</h2>
        <p class="mt-3">
          <a href={`tel:${site.phone.e164}`} class="text-lg font-semibold hover:text-primary-bright">{site.phone.display}</a>
        </p>
        <p><a href={`mailto:${site.email}`} class="text-muted-foreground hover:text-foreground">{site.email}</a></p>
      </div>
    </aside>
  </section>

  {
    gymdesk.trialBookingEnabled && (
      <section class="container-page mt-24">
        <SectionHeading eyebrow="Ready now?" title="Pick your class" lead="Prefer to choose a time yourself? Book your free class directly." />
        <div class="mt-8">
          <Gymdesk kind="booking" theme="dark" />
        </div>
      </section>
    )
  }

  <section class="container-page mt-24">
    <SectionHeading eyebrow="Community" title="What students say" />
    <div class="mt-10"><Reviews /></div>
  </section>
</BaseLayout>
