---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import Analytics from '../components/Analytics.astro';
import ConsentNotice from '../components/ConsentNotice.astro';
import { isProduction, ga4Id } from '../lib/env';
import { localBusinessSchema, websiteSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  /** Page-specific title; the site name is appended. */
  title?: string;
  description?: string;
  /** Short name for the breadcrumb trail (defaults to title). */
  breadcrumb?: string;
  /** Root-relative OG image path (1200×630). */
  image?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
}

const { title, description = site.tagline, breadcrumb, image = '/og-default.jpg', noindex = false, schema = [] } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Jiu-Jitsu in Lee's Summit, MO`;
// build.format 'file' makes pathname '/index.html', '/schedule.html' — canonicalize to clean URLs.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(image, site.url).href;
const robots = !isProduction || noindex ? 'noindex, nofollow' : 'index, follow';
const isHome = cleanPath === '/';
const jsonLd = [
  localBusinessSchema(),
  ...(isHome ? [websiteSchema()] : []),
  ...(!isHome && !noindex
    ? [breadcrumbSchema([{ name: 'Home', path: '/' }, { name: breadcrumb ?? title ?? site.name, path: cleanPath }])]
    : []),
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="US-MO" />
    <meta name="geo.placename" content={site.address.city} />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />

    <Font cssVariable="--font-barlow-condensed" preload />
    <Font cssVariable="--font-archivo" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {isProduction && ga4Id && <Analytics id={ga4Id} />}

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 btn-primary">
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {isProduction && ga4Id && <ConsentNotice />}
  </body>
</html>
