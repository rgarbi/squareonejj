---
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-border rounded-(--radius) border border-border bg-surface">
  {
    items.map((f) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
          <h3 class="font-sans text-base font-semibold normal-case tracking-normal">{f.q}</h3>
          <span class="text-2xl leading-none text-primary-bright transition-transform group-open:rotate-45" aria-hidden="true">
            +
          </span>
        </summary>
        <p class="mt-3 text-muted-foreground">{f.a}</p>
      </details>
    ))
  }
</div>
