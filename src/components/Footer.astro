---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-mark-dark-bg.png';
import { site, formattedAddress, hours, days, formatTime } from '../data/site';
import { gymdesk } from '../config/gymdesk';

const columns = [
  {
    title: 'Train',
    links: [
      { href: '/programs/adult-bjj', label: 'Adult jiu jitsu' },
      { href: '/programs/kids-bjj', label: 'Kids jiu jitsu' },
      { href: '/schedule', label: 'Schedule' },
      { href: '/pricing', label: 'Pricing' },
      { href: '/free-trial', label: 'Free class' },
    ],
  },
  {
    title: 'Academy',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/new-here', label: 'New here? / FAQ' },
      { href: '/contact', label: 'Contact' },
      { href: gymdesk.links.signup, label: 'Become a member' },
      { href: gymdesk.links.login, label: 'Member login' },
    ],
  },
];

const hoursByDay = days.map((day) => ({
  day,
  ranges: hours.filter((h) => h.day === day).map((h) => `${formatTime(h.opens)}–${formatTime(h.closes)}`),
}));

const socials = [
  { href: site.socials.instagram, label: 'Instagram' },
  { href: site.socials.facebook, label: 'Facebook' },
  { href: site.socials.youtube, label: 'YouTube' },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
        <Image src={logo} alt="" width={48} height={48} class="size-12" />
        <span class="font-display text-xl leading-none font-bold uppercase">Square One<br />Jiu Jitsu</span>
      </a>
      <address class="mt-6 space-y-1 text-sm text-muted-foreground not-italic">
        <a href={site.mapsUrl} class="block hover:text-foreground">{formattedAddress}</a>
        <a href={`tel:${site.phone.e164}`} class="block hover:text-foreground">{site.phone.display}</a>
        <a href={`mailto:${site.email}`} class="block hover:text-foreground">{site.email}</a>
      </address>
      <ul class="mt-6 flex gap-4 text-sm">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} class="text-muted-foreground hover:text-foreground" rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      columns.map((col) => (
        <div>
          <h2 class="text-lg">{col.title}</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-muted-foreground hover:text-foreground">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h2 class="text-lg">Hours</h2>
      <dl class="mt-4 space-y-1 text-sm">
        {
          hoursByDay.map(({ day, ranges }) => (
            <div class="flex justify-between gap-4">
              <dt class="text-muted-foreground">{day.slice(0, 3)}</dt>
              <dd class="text-right whitespace-nowrap">
                {ranges.length ? ranges.map((r) => <span class="block">{r}</span>) : 'Closed'}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-xs text-muted-foreground">Open during scheduled classes. Call or message to visit at another time.</p>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-muted-foreground sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName}</p>
      <p>Proud affiliate of {site.affiliation.name} under {site.affiliation.leader}</p>
    </div>
  </div>
</footer>
