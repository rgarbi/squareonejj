---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-mark-dark-bg.png';
import { site } from '../data/site';
import { gymdesk } from '../config/gymdesk';

const nav = [
  { href: '/programs/adult-bjj', label: 'Adults' },
  { href: '/programs/kids-bjj', label: 'Kids' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/new-here', label: 'New here' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-border bg-background/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="eager" class="size-10" />
      <span class="font-display text-lg leading-none font-bold uppercase">
        Square One<span class="block text-sm font-semibold tracking-widest text-muted-foreground">Jiu Jitsu</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-6 font-display text-base font-semibold uppercase tracking-wide">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? 'page' : undefined}
                class="text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={gymdesk.links.login} class="hidden text-sm text-muted-foreground hover:text-foreground sm:block">
        Member login
      </a>
      <a href="/free-trial" class="btn-primary px-4 py-2 text-base">Free class</a>

      <!-- Zero-JS mobile menu -->
      <details class="group relative lg:hidden">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-(--radius) border border-border [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-64 rounded-(--radius) border border-border bg-surface p-2 shadow-xl">
          <ul class="font-display text-lg font-semibold uppercase">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="block rounded-(--radius) px-3 py-2 hover:bg-muted">
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-2 border-t border-border pt-2">
              <a href={gymdesk.links.login} class="block rounded-(--radius) px-3 py-2 hover:bg-muted">Member login</a>
            </li>
            <li>
              <a href={`tel:${site.phone.e164}`} class="block rounded-(--radius) px-3 py-2 hover:bg-muted">{site.phone.display}</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
