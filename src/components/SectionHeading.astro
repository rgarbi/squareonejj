---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  center?: boolean;
}

const { eyebrow, title, lead, center = false } = Astro.props;
---

<div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-2 text-4xl sm:text-5xl">{title}</h2>
  {lead && <p class="mt-4 text-muted-foreground">{lead}</p>}
</div>
