---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-border bg-surface">
  <div class="container-page py-14 sm:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-4xl text-5xl sm:text-6xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-muted-foreground">{lead}</p>}
    <slot />
  </div>
</section>
