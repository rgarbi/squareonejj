---
import { plans, pricingTerms } from '../data/pricing';

interface Props {
  /** Two columns max, for use in half-width layouts. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['grid gap-4 sm:grid-cols-2', !compact && 'lg:grid-cols-4']}>
  {
    plans.map((p, i) => (
      <div class:list={['rounded-(--radius) border bg-surface p-6', i === 0 ? 'border-primary' : 'border-border']}>
        <h3 class="text-2xl">{p.name}</h3>
        <p class="mt-4">
          <span class="font-display text-5xl font-bold">${p.price}</span>
          <span class="text-muted-foreground"> / month</span>
        </p>
      </div>
    ))
  }
</div>
<ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm">
  {
    pricingTerms.map((t) => (
      <li class="flex items-center gap-2">
        <span class="text-primary-bright" aria-hidden="true">✓</span>
        {t}
      </li>
    ))
  }
</ul>
