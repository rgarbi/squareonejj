# Square One Jiu Jitsu — Hostinger (Apache/LiteSpeed). See PLAN.md §10 and item 15.
# Canonical: https://squareonejj.com, no trailing slash, pages built as /page.html.

Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On

# --- Canonical host + HTTPS (skip on Hostinger temp/preview domains) ---
RewriteCond %{HTTP_HOST} ^www\.squareonejj\.com$ [NC]
RewriteRule ^ https://squareonejj.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^squareonejj\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://squareonejj.com%{REQUEST_URI} [R=301,L]

# --- Legacy Gymdesk URLs ---
RewriteRule ^book/?$ /schedule [R=301,L]
RewriteRule ^gallery/?$ /about#gallery [R=301,NE,L]
RewriteRule ^shop/?$ / [R=301,L]

# /programs has no index page (only /programs/adult-bjj and /programs/kids-bjj)
RewriteRule ^programs/?$ /#programs [R=302,NE,L]
# TODO: confirm Gymdesk standalone URLs at cutover (src/config/gymdesk.ts)
RewriteRule ^signup/?$ https://squareonejj.gymdesk.com/signup [R=302,L]
RewriteRule ^login/?$ https://squareonejj.gymdesk.com/login [R=302,L]

# --- Clean URLs ---
# /about.html -> /about
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
# /about/ -> /about
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]
# /about -> serve about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# --- Caching ---
<IfModule mod_headers.c>
  # Astro's hashed assets never change.
  SetEnvIf Request_URI "^/_astro/" ASTRO_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
